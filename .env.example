# Copy to .env and fill with real values from your password manager.
# Never commit .env to git.

TMDB_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Used only by spike 09's probe (in the owner's .env it is the cloud M0 cluster).
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
# The app's database (feat-030). Default: the local container from compose.yaml.
# MONGODB_URI above is never read by the app.
WATCH_TONIGHT_MONGODB_URI=mongodb://localhost:27017/?directConnection=true
