htmlcov/

# Harness local state
.harness/
.claude/settings.local.json

# Secrets & environment variables (like appsettings.Development.json / user-secrets)
.env
.env.*
!.env.example

# Frontend (web/)
node_modules/
web/dist/
web/.vite/

# OS & editor files
.DS_Store
Thumbs.db
