# Python virtual environments & build artifacts (like bin/ and obj/ in .NET)
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Tool caches (like .vs/ in Visual Studio)
.pytest_cache/
.ruff_cache/
.pyright/
.import_linter_cache/
.mutmut-cache/
